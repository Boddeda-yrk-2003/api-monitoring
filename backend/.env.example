# ---------- service ----------
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
SELF_BASE_URL=http://127.0.0.1:8000

# ---------- monitoring ----------
PROBE_INTERVAL_SECONDS=10
REQUEST_TIMEOUT_SECONDS=10
SEED_HISTORY_ON_STARTUP=true
SEED_HISTORY_HOURS=24

# ---------- alert thresholds ----------
LATENCY_THRESHOLD_MS=3000
ERROR_RATE_THRESHOLD_PCT=5
ERROR_RATE_WINDOW_MINUTES=5
DOWNTIME_CONSECUTIVE_FAILURES=2
RECOVERY_CONSECUTIVE_SUCCESSES=2
ALERT_COOLDOWN_SECONDS=60

# ---------- sample API ----------
VALID_API_KEYS=demo-api-key-123,monitoring-key-456
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
SIMULATED_TIMEOUT_SECONDS=6

# ---------- notifications (leave empty for DRY-RUN) ----------
SLACK_WEBHOOK_URL=
SLACK_CHANNEL_LABEL=#api-alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=apiguard-alerts@example.com
ALERT_EMAIL_TO=sre-oncall@example.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_CALL_TO_NUMBER=
